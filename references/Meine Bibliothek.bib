@article{booltinkEffectsRDIntensity2018,
  title = {The Effects of {{R}}\&{{D}} Intensity and Internationalization on the Performance of Non-High-Tech {{SMEs}}},
  author = {Booltink, Lucas Wa and {Saka-Helmhout}, Ayse},
  year = 2018,
  month = feb,
  journal = {International Small Business Journal: Researching Entrepreneurship},
  volume = {36},
  number = {1},
  pages = {81--103},
  issn = {0266-2426, 1741-2870},
  doi = {10.1177/0266242617707566},
  urldate = {2026-05-21},
  abstract = {Research and Development (R\&D) investment is seen as a fundamental driver of high-tech small and medium-sized (SME) firm performance. However, the same driver may be constraining growth among non-high-tech SMEs as it increases the level of risk faced by such firms. We challenge this argument by examining the relationship between R\&D intensity and performance among non-high-tech SMEs. While the size of R\&D investments is, by definition, limited in the non-high-tech sector, our study shows that such investments are important for non-high-tech firms. There is, however, an inverted U-shaped relationship between R\&D intensity and performance among non-high-tech SMEs. Furthermore, increased internationalization leads non-high-tech SMEs to exploit their R\&D investment more effectively to enhance firm performance, provided that R\&D investment levels exceed a critical threshold.},
  langid = {english},
  file = {/Users/siti/Zotero/storage/R37JJBSY/Booltink und Saka-Helmhout - 2018 - The effects of R&D intensity and internationalization on the performance of non-high-tech SMEs.pdf}
}

